{
  // Cloudflare Workers Builds deploys the static site from out/ (built by
  // `pnpm build` with root directory docs/). No server code: assets only.
  // _headers in out/ sets the security and cache headers.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "waterlock",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    // /blog serves blog.html; unknown paths get out/404.html with a 404.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Workers Logs (free plan: 200k events a day, 3 days' retention).
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
