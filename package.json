{
  "name": "@waterlock/gateway",
  "version": "0.2.0",
  "description": "Credential-injecting policy gateway for AI agent tool calls",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waterlockcc/waterlock.git"
  },
  "homepage": "https://github.com/waterlockcc/waterlock#readme",
  "bugs": "https://github.com/waterlockcc/waterlock/issues",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./codegen": {
      "types": "./dist/codegen/index.d.ts",
      "default": "./dist/codegen/index.js"
    },
    "./providers/gmail": {
      "types": "./dist/providers/gmail/index.d.ts",
      "default": "./dist/providers/gmail/index.js"
    },
    "./providers/linear": {
      "types": "./dist/providers/linear/index.d.ts",
      "default": "./dist/providers/linear/index.js"
    },
    "./checks": {
      "types": "./dist/checks/index.d.ts",
      "default": "./dist/checks/index.js"
    },
    "./graphql": {
      "types": "./dist/graphql/index.d.ts",
      "default": "./dist/graphql/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build",
    "gen:gmail": "tsx src/codegen/cli.ts src/providers/gmail/gmail.config.ts",
    "gen:gmail:fetch": "tsx src/codegen/cli.ts src/providers/gmail/gmail.config.ts --fetch",
    "gen:linear": "tsx src/codegen/cli.ts src/providers/linear/linear.config.ts",
    "gen:linear:fetch": "tsx src/codegen/cli.ts src/providers/linear/linear.config.ts --fetch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\" && tsx scripts/comment-width.ts"
  },
  "dependencies": {
    "graphql": "^17.0.2",
    "postal-mime": "4.2.0"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.110",
    "@googleapis/gmail": "^22.0.2",
    "@graphql-tools/mock": "10.1.3",
    "@hono/node-server": "^2.1.6",
    "@linear/sdk": "99.0.0",
    "@types/node": "^26.6.6",
    "ai": "^7.0.164",
    "ai-sdk-provider-claude-code": "^4.4.1",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
