{
  "name": "waterlock",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck && tsc --noEmit",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\" && tsx scripts/comment-width.ts",
    "gen:gmail": "pnpm -F @waterlock/gateway gen:gmail",
    "gen:gmail:fetch": "pnpm -F @waterlock/gateway gen:gmail:fetch",
    "gen:linear": "pnpm -F @waterlock/gateway gen:linear",
    "gen:linear:fetch": "pnpm -F @waterlock/gateway gen:linear:fetch"
  },
  "devDependencies": {
    "@ai-sdk/openai": "^4.0.110",
    "@googleapis/gmail": "^22.0.2",
    "@graphql-tools/mock": "10.1.3",
    "@hono/node-server": "^2.1.6",
    "@linear/sdk": "99.0.0",
    "@types/node": "^26.6.6",
    "ai": "^7.0.164",
    "ai-sdk-provider-claude-code": "^4.4.1",
    "graphql": "^17.0.2",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
